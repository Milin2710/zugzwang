PORT=4000
MONGODB_URI=mongodb://localhost:27017/chessing
REDIS_URL=redis://localhost:6379

# Required: the server verifies Clerk session tokens and reads usernames from Clerk
CLERK_SECRET_KEY=sk_test_xxx

# Comma-separated list of frontend origins (CORS + Clerk "authorized parties")
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- optional game tuning (defaults shown) ---
# TIME_CONTROL_MS=600000        # 10 minutes each
# TIME_INCREMENT_MS=0
# FIRST_MOVE_MS=30000           # each side must make its first move within this, or the game is aborted
# DISCONNECT_GRACE_MS=30000     # time a disconnected player has to come back before forfeiting
# MM_BASE_WINDOW=100            # matchmaking: accepted rating gap at the start...
# MM_WINDOW_GROWTH=20           # ...plus this many points per second waited
# ELO_K=32
# LOG_LEVEL=info
